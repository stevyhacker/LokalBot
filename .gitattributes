# Check text files out as LF on every platform. Git for Windows defaults to
# core.autocrlf=true, which replaces LF with CRLF in the worktree. eol=lf
# overrides that (and core.eol). text=auto leaves binaries unchanged.
* text=auto eol=lf

# Generated by scripts/sync-localizations.py: keep it out of GitHub language stats and collapse it in diffs.
LinuxWindows/crates/lokalbot-i18n/src/catalogs.rs linguist-generated=true

# Windows batch scripts need CRLF line endings. This line overrides the rule above.
Companion/android/gradlew.bat text eol=crlf
