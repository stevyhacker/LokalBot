{"bundle": "com.apple.TextEdit", "title": "Notes", "size": [960, 600], "bottom": 0, "settle": 1.2, "cursor": false, "ownInput": true, "park": [-240, -160], "pre": 0.6, "post": 2.0, "also": ["me.dotenv.LokalBot.uitesthost"],
 "setup":[{"key": "down", "mods": ["cmd"]}],
 "actions":[
  {"wait": 0.6},
  {"mark": "before"},
  {"hold": ["option", "shift"], "during": [{"wait": 5.0}, {"mark": "spoken"}]},
  {"mark": "released"},
  {"until": {"contains": "Lisbon"}, "timeout": 45, "optional": true},
  {"mark": "written"},
  {"wait": 1.8},
  {"reject": "Notes.txt"},
  {"reject": "**"}]}
