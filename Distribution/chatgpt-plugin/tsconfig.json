{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": ".test-build"
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["src/relay/index.ts", "src/relay/room.ts"]
}
