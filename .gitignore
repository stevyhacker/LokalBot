# Generated by xcodegen — recreate with `xcodegen generate`. Keep only the
# SwiftPM lockfile so release/CI builds resolve the exact reviewed revisions.
LokalBot.xcodeproj/*
!LokalBot.xcodeproj/project.xcworkspace/
LokalBot.xcodeproj/project.xcworkspace/*
!LokalBot.xcodeproj/project.xcworkspace/xcshareddata/
LokalBot.xcodeproj/project.xcworkspace/xcshareddata/*
!LokalBot.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
LokalBot.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!LokalBot.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# Personal scratch work: launch copy, private notes, prototypes, exported
# handoffs, release evidence, generated previews. Never commit credentials here.
/Local/

# Vendored llama.cpp + models — fetched by Scripts/build/fetch-llama.sh
/Vendor/

.DS_Store
.build/
__pycache__/
.ruff_cache/

# Local tool caches and output
.wrangler/
.cloudflare/
.codex-attachments/
muter_logs/
/build/
/output/

# SDD progress ledger (scratch)
.superpowers/

# Coverage counters regenerated by every test run
*.profraw

# Packaging output: Scripts/release/build-mcpb.sh, Scripts/release/build-openai-plugin.sh, LinuxWindows packaging
dist/

# Local agent/browser workspaces and snapshots
.claude/launch.json
.claude/serve-web.js
.codex/environments/
.playwright-mcp/

# Generated design and UI QA captures
Artifacts/

# Generated video-production output and locally reproducible media
Video/**/.hyperframes/
Video/**/.media/
Video/**/.thumbnails/
Video/**/.waveform-cache/
Video/**/capture/
Video/**/renders/
Video/**/snapshots/
Video/**/node_modules/
Video/**/assets/fonts/
Video/**/assets/bgm/
Video/**/assets/sfx/
Video/**/assets/voice/
Video/**/audio_engine_meta.json
Video/**/audio_meta.json
Video/**/audio_request.json
Video/**/bgm_request.json
Video/**/bgm_status.json

# The canonical landscape promo keeps its request manifest as source. Audio,
# fonts, renders, and provider metadata remain reproducible local output.
!Video/lokalbot-promo/audio_request.json

# Plan scratch that agent plugins write; finished plans go to Docs/plans.
Docs/superpowers/

# Derived social crops and unused local website handoff material. The canonical
# 16:9 source lives in Video/lokalbot-promo/.
Video/lokalbot-promo-square/
Video/lokalbot-promo-vertical/
Website/public/assets/feature-demo-poster.jpg
Website/public/assets/fonts/

# Raycast extension generated files and local install
Distribution/raycast/raycast-env.d.ts
Distribution/raycast/node_modules/

# iPhone and iPad companion: XcodeGen output (run `xcodegen generate` in
# Companion/ios) and Xcode's package workspace state.
Companion/ios/LokalBotCompanion.xcodeproj/
Companion/ios/LokalBotCompanionKit/.swiftpm/

# Android companion (Companion/android): Gradle and IDE state, build output,
# and the Rust libraries and UniFFI bindings Scripts/build/build-sync-android.sh writes.
Companion/android/.gradle/
Companion/android/.kotlin/
Companion/android/.idea/
Companion/android/local.properties
Companion/android/**/build/
Companion/android/sync/build/rust/
