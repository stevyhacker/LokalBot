  "license": "GPL-3.0",
  "keywords": ["meetings", "transcription", "local-llm", "mcp", "privacy"],
  "commands": ["./Distribution/claude-plugin/commands"],
  "skills": ["./.agents/skills/lokalbot-cli"],
  "mcpServers": {
    "lokalbot": {
      "command": "lokalbot-cli",
      "args": ["mcp"]
    }
  }
