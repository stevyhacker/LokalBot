# Keys for remote_comparison.py. Copy this file outside the repository, for example
# to ~/.config/lokalbot/remote-autocomplete.env, fill it in and `chmod 600` it.
# Each key is passed only to the replay of its own provider.
CEREBRAS_API_KEY=
MODULAR_API_KEY=
COREWEAVE_API_KEY=
TOGETHER_API_KEY=
# Alone, with --via-openrouter: all three models through OpenRouter, each pinned to the same provider.
OPENROUTER_API_KEY=
