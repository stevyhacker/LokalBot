<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration: windows-installer
     Signs the Inno Setup installer executable built from signed LokalBot binaries.
     Inno Setup 6 space-pads VersionInfoProductName in its setup stub, so product-name
     is enforced on windows-binaries rather than the Inno Setup wrapper.
     Upload under Project -> Artifact configurations with slug `windows-installer`. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1"
                        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                        xsi:schemaLocation="http://signpath.io/artifact-configuration/v1 https://app.signpath.io/Web/artifact-configuration/v1.xsd">
  <zip-file>
    <pe-file path="LokalBot-*-windows-x86_64-setup.exe">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
