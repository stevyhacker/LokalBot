# LokalBot (alpha). The lokalbot package added this file so that
# `sudo dnf upgrade` installs new versions. Your edits are kept on upgrades;
# set enabled=0 to stop updates from this repository.
[lokalbot]
name=LokalBot (alpha)
baseurl=https://pkg.lokalbot.com/rpm
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-lokalbot
metadata_expire=6h
skip_if_unavailable=True
